# Rita's private environment for docker-compose.v6.yml. Copy to rita.env (ignored by Git),
# chmod 600. Never commit the filled copy.
# OPENAI_BASE_URL: OpenAI-compatible model endpoint, e.g. https://llm.YOUR-TAILNET.ts.net/v1
OPENAI_BASE_URL=
# OPENAI_API_KEY: the endpoint's key (a placeholder if your endpoint accepts one)
OPENAI_API_KEY=
# DEFAULT_MODEL: e.g. openai:qwen3.6-35b
DEFAULT_MODEL=
# PORT: 7777
PORT=7777
