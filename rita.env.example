# Rita's private environment for docker-compose.v6.yml. Copy to rita.env (ignored by Git),
# chmod 600. Never commit the filled copy.
# OPENAI_BASE_URL: OpenAI-compatible model endpoint, e.g. https://llm.YOUR-TAILNET.ts.net/v1
# Direct DeepInfra example tested in the release walk: https://api.deepinfra.com/v1/openai
OPENAI_BASE_URL=
# OPENAI_API_KEY: the endpoint's key (a placeholder if your endpoint accepts one)
OPENAI_API_KEY=
# DEFAULT_MODEL: select a model offered by that endpoint, e.g. openai:qwen3.6-35b
# Tested DeepInfra example: openai:Qwen/Qwen3.6-35B-A3B (operator-selected; no automatic default)
DEFAULT_MODEL=
# PORT: 7777
PORT=7777
