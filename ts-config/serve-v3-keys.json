{
  "TCP": {
    "443": {
      "HTTPS": true
    },
    "8443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://openbq-api:6900"
        }
      }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": {
        "/": {
          "Proxy": "http://openbq-reference:17783"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": false,
    "${TS_CERT_DOMAIN}:8443": false
  },
  "Services": {
    "svc:openbq-keys": {
      "TCP": {
        "443": {
          "HTTPS": true
        }
      },
      "Web": {
        "openbq-keys.<your-tailnet>.ts.net:443": {
          "Handlers": {
            "/": {
              "Proxy": "http://key-maint:8447"
            }
          }
        }
      }
    }
  }
}
