[
  {
    "name": "Example Dashboard - Version 10.0.0 - Live Grid",
    "description": "Episode 10 brings the live grid. Live quotes is a table that streams: its snapshot arrives over HTTP, then each quote ticks in place over live-grid's websocket, with each symbol's logo and 52-week range from live-grid's symbol_meta. Beside it, the subscription list that feeds the stream, the kdb+ tick history behind one symbol, the Live Chart and the Cached Price Chart. Every card is served by the stack's live-grid backend (its opt-in live profile), so add that backend as a connection first; this version does not draw the Live Chart's live_chart type and shows its data as raw JSON. Made for, and opens in, BDOBB 10.0.0 or later.",
    "img": "",
    "img_dark": "",
    "img_light": "",
    "allowCustomization": true,
    "tabs": {
      "live": {
        "id": "live",
        "name": "Live",
