#
# Compose-level settings, substituted into docker-compose.yml (not passed into containers).
#   cp .env.example .env      (.env is git-ignored)
# Each is optional; unset, the default in docker-compose.yml applies.

# Where the KX licence (kc.lic) is read from, mounted read-only into kdb and live-grid
# (eod-dump runs PyKX unlicensed). Default ./kdb-license. Point it at a directory outside this repository to keep
# the licence out of the checkout, e.g. KDB_LICENSE_DIR=../my-private-checkout/kdb-license.
# KDB_LICENSE_DIR=./kdb-license

# Where RustFS keeps the S3 store's data (a host directory, persistent). Default ./rustfs-data.
# RUSTFS_DATA_DIR=

# The openbq-kdb image. Default: the maintainer's private, digest-pinned, linux/amd64-only
# image, which nobody else can pull (kdb+ is proprietary; no kdb image is published). Name your
# own here, or build one from your licensed KDB-X with compose.kdb-build.yml.
# KDB_IMAGE=

# KDB-X release for compose.kdb-build.yml. Default KX's ~latest~.
# KX_VERSION=

# Use the v3 overlay with every compose command (its openbq-api image is the Dockerfile's
# `v3` stage, openbq-local:10.0.0). Since v9 both API images, the `api` and `v3` stages,
# include openbq-eodhd 9.0.1, which live-grid's history needs (/api/v1/eodhd).
# COMPOSE_FILE=docker-compose.yml:docker-compose.v3.yml

# Opt-in managed native tables; prepare-source.mjs writes table-build.env with pinned values.
# TABLE_SOURCE_CONTEXT=/absolute/path/to/exported-table-source
# TABLE_SOURCE_REVISION=<exact revision from table-service/source.lock.json>
# TABLE_SOURCE_TREE=<exact Git tree from table-service/source.lock.json>
# TABLE_MEMORY_LIMIT=8g
# TABLE_CPUS=2
