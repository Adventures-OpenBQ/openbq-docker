#
# The `live` profile's S3 store (v10): RustFS, and the Delta Lake connection to it.
#   cp rustfs.env.example rustfs.env && chmod 600 rustfs.env
# Never commit rustfs.env (*.env is git-ignored). Keep comments on their OWN lines:
# compose's env_file parser keeps an inline "# comment" as part of the value.

# --- RustFS root credentials. Set your own, long and random. ---
# rustfs refuses to start while either is empty or left at RustFS's public default
# (rustfsadmin). They are the store's ROOT pair; the store is on the compose bridge only
# (no host port, no Serve, no Funnel), so only the stack's own services reach it.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# --- Where the store keeps its data ---
# A host directory, ./rustfs-data by default (git-ignored), persistent across container
# recreation, upgrades and `docker compose down -v`. To move it, set RUSTFS_DATA_DIR in the
# SHELL or in .env (compose substitutes it into the volume; it is not read from this file).

# --- Where Delta Lake finds the store (eod-dump writes, live-grid reads back) ---
# The compose service name over plain HTTP on the bridge, path-style addressing
# (openbb-deltalake sets aws_virtual_hosted_style_request=false).
DELTA_S3_ENDPOINT=rustfs
DELTA_S3_PORT=9000
DELTA_S3_SECURE=false
DELTA_S3_BUCKET=openbq
# These MUST equal RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY above, written out literally
# (compose does not interpolate ${...} inside an env_file).
DELTA_S3_ACCESS=
DELTA_S3_SECRET=
