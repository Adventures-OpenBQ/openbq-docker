[
  {
    "name": "FX linked surface",
    "description": "Keyless CFTC EURUSD implied volatility and a surface linked to the same table card. Filter or sort the table to change the chart scope; missing observations stay gaps. Requires this episode\u2019s OpenBQ backend and BDOBB build.",
    "img": "/openbq/bdobb-logo.svg",
    "img_dark": "data:image/svg+xml;base64,",
    "img_light": "data:image/svg+xml;base64,",
    "allowCustomization": true,
    "tabs": {
      "fx": {
        "id": "fx",
        "name": "EURUSD volatility",
        "layout": [
          {
            "i": "cftc_fx_implied_vol_cftc_obb",
            "x": 0,
            "y": 0,
            "w": 40,
            "h": 15,
            "state": {
              "params": {
                "pair": "EURUSD",
                "basis": "empirical",
                "min_trades": "3",
                "use_cache": "true",
                "provider": "cftc"
              },
              "extensions": {
                "bdobb": {
                  "schemaVersion": 1,
                  "profile": "v3",
                  "instanceId": "c0"
                }
              }
            }
          },
          {
            "i": "linked_chart",
            "x": 0,
            "y": 15,
            "w": 40,
            "h": 22,
            "state": {
              "params": {},
              "extensions": {
                "bdobb": {
                  "schemaVersion": 1,
                  "profile": "v3",
                  "instanceId": "c1",
                  "sourceRef": "c0",
                  "linkedChart": {
                    "type": "surface",
                    "display": "grouped",
                    "category": "strike",
                    "measures": [
                      "vol_1w",
                      "vol_2w",
                      "vol_1m",
                      "vol_2m",
                      "vol_3m",
                      "vol_6m",
                      "vol_9m",
                      "vol_1y",
                      "vol_2y"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "extensions": {
      "bdobb": {
        "schemaVersion": 1,
        "profile": "v3",
        "tabOrder": [
          "fx"
        ]
      }
    }
  },
  {
    "name": "Built-in widgets",
    "description": "Embedded notes, clocks, web viewers and controls on their own tabs, plus grouped Parameter echo cards. The Linked surface tab needs a source table from a data backend; the dedicated FX example provides one.",
    "img": "/openbq/bdobb-logo.svg",
    "img_dark": "data:image/svg+xml;base64,",
    "img_light": "data:image/svg+xml;base64,",
    "allowCustomization": true,
    "tabs": {
      "note": {
        "id": "note",
        "name": "Note",
        "layout": [
          {
            "i": "note",
            "x": 0,
            "y": 0,
            "w": 20,
            "h": 10,
            "state": {
              "params": {
                "text": "This is a Note card. Its text is a hidden parameter, so it does not clutter the header's controls row and it travels with the dashboard on export. Click anywhere in the body to edit; Escape throws a draft away."
              }
            }
          }
        ]
      },
      "markdown": {
        "id": "markdown",
        "name": "Markdown",
        "layout": [
          {
            "i": "markdown",
            "x": 0,
            "y": 0,
            "w": 26,
            "h": 16,
            "state": {
              "params": {
                "text": "# Markdown card\n\nA rich-text note with a formatting toolbar. Edits save on their own about half a second after you stop typing.\n\n## What it can show\n\n- Headings, like the two above\n- A bulleted list, like this one\n- **Bold**, *italic*, and a [link to the Workspace docs](https://docs.openbb.co/workspace)\n\n```\nconst example = \"a fenced code block\";\n```\n"
              }
            }
          }
        ]
      },
      "clock": {
        "id": "clock",
        "name": "Clock",
        "layout": [
          {
            "i": "clock",
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 16,
            "state": {
              "params": {
                "zones": "America/New_York,Europe/London,Asia/Tokyo",
                "layout": "vertical",
                "hourCycle": "24",
                "face": "dots"
              }
            }
          },
          {
            "i": "clock",
            "x": 18,
            "y": 0,
            "w": 22,
            "h": 8,
            "state": {
              "params": {
                "zones": "America/New_York,Europe/London,Asia/Tokyo",
                "layout": "horizontal",
                "hourCycle": "24",
                "face": "dots"
              }
            }
          }
        ]
      },
      "website": {
        "id": "website",
        "name": "Website",
        "layout": [
          {
            "i": "website",
            "x": 0,
            "y": 0,
            "w": 40,
            "h": 24,
            "state": {
              "params": {
                "url": "https://docs.openbb.co/workspace"
              }
            }
          }
        ]
      },
      "rss": {
        "id": "rss",
        "name": "RSS",
        "layout": [
          {
            "i": "rss",
            "x": 0,
            "y": 0,
            "w": 22,
            "h": 20,
            "state": {
              "params": {
                "url": "https://feeds.bbci.co.uk/news/business/rss.xml",
                "limit": "20"
              }
            }
          }
        ]
      },
      "grouping": {
        "id": "grouping",
        "name": "Grouping",
        "layout": [
          {
            "i": "note",
            "x": 0,
            "y": 0,
            "w": 20,
            "h": 8,
            "state": {
              "params": {
                "text": "The two Parameter echo cards below share a Ticker group: the chain-link beside each card's Ticker control opens the Groups menu, the numbered badge shows which group a control is in, and editing either card's Ticker moves both."
              }
            }
          },
          {
            "i": "param_echo",
            "x": 0,
            "y": 8,
            "w": 14,
            "h": 6,
            "groups": [
              "Ticker"
            ],
            "state": {
              "params": {
                "date": "$currentDate"
              }
            }
          },
          {
            "i": "param_echo",
            "x": 14,
            "y": 8,
            "w": 14,
            "h": 6,
            "groups": [
              "Ticker"
            ],
            "state": {
              "params": {
                "date": "$currentDate"
              }
            }
          }
        ]
      },
      "linked-surface": {
        "id": "linked-surface",
        "name": "Linked surface",
        "layout": [
          {
            "i": "linked_chart",
            "x": 0,
            "y": 0,
            "w": 30,
            "h": 18,
            "state": {
              "params": {}
            }
          },
          {
            "i": "note",
            "x": 30,
            "y": 0,
            "w": 25,
            "h": 10,
            "state": {
              "params": {
                "text": "Add a table from your data backend, then choose Create linked surface in its card menu. The FX linked-surface example provides the real keyless CFTC table and its linked chart. Source/category/measure choices live in the chart body."
              }
            }
          }
        ]
      }
    },
    "groups": [
      {
        "name": "Ticker",
        "type": "param",
        "paramName": "ticker",
        "defaultValue": "AAPL"
      }
    ],
    "prompts": []
  },
  {
