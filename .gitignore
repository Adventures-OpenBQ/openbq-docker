# The v10 `live` profile. Bring your own kdb+ licence and q startup scripts; never commit
# a licence or a key. kdb-license/ keeps only its .gitkeep.
kdb-license/*
!kdb-license/.gitkeep
kdb-data/
live-grid-data/
*.lic
*.egg-info/
.pytest_cache/

# The v10 `live` profile's S3 tier (RustFS) and the nightly flush. Never commit the
# store's data or its credentials (rustfs.env and eod.env are covered by *.env above).
rustfs-data/
minio-data/
rustfs.env
eod.env

# Task-owned local native table build and private operator configuration.
table-source/
table-config/
table-build.env
