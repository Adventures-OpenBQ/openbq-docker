# Context contains only yfinance.tar, the reviewed clean provider source archive.
ARG TEMPORALDB_BASE_IMAGE=python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d
FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d AS sdk
RUN python -m pip install --no-cache-dir --root-user-action=ignore uv==0.11.19
WORKDIR /opt/managed-yahoo
COPY yfinance.tar /tmp/yfinance.tar
RUN echo 'b61b6be5d672497db521978fb58b61a89059dcccfdc003c5d47607f3a8b826a7  /tmp/yfinance.tar' | sha256sum -c - \
 && tar -xf /tmp/yfinance.tar -C /opt/managed-yahoo \
 && rm /tmp/yfinance.tar \
 && uv sync --python /usr/local/bin/python --frozen --no-dev --no-editable \
 && groupadd --gid 65532 openbq \
 && useradd --uid 65532 --gid 65532 --home-dir /run/managed-yahoo --no-create-home --shell /usr/sbin/nologin openbq \
 && mkdir -p /run/managed-yahoo && chown 65532:65532 /run/managed-yahoo
LABEL io.openbq.managed-yfinance.source-revision='d867c8bb64fda4dc843146a44f46ec7ca17e0ae8' \
      io.openbq.managed-yfinance.archive-sha256='b61b6be5d672497db521978fb58b61a89059dcccfdc003c5d47607f3a8b826a7'
ENV HOME='/run/managed-yahoo' PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
CMD ["/opt/managed-yahoo/.venv/bin/python", "-c", "import importlib.metadata as m; print({p:m.version(p) for p in ['openbq-yfinance','openbb-core','yfinance','pandas','numpy']})"]

FROM ${TEMPORALDB_BASE_IMAGE} AS runtime
USER 0:0
COPY --from=sdk /opt/managed-yahoo /opt/managed-yahoo
RUN if ! getent group 65532 >/dev/null; then groupadd --gid 65532 openbq; fi \
 && if ! getent passwd 65532 >/dev/null; then useradd --uid 65532 --gid 65532 --home-dir /run/temporaldb --no-create-home --shell /usr/sbin/nologin openbq; fi
ENV TEMPORALDB_YFINANCE_PYTHON='/opt/managed-yahoo/.venv/bin/python'
LABEL io.openbq.managed-yfinance.source-revision='d867c8bb64fda4dc843146a44f46ec7ca17e0ae8' \
      io.openbq.managed-yfinance.archive-sha256='b61b6be5d672497db521978fb58b61a89059dcccfdc003c5d47607f3a8b826a7'
USER 65532:65532
