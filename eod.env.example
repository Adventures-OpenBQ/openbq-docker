#
# eod-dump (v10, the `live` profile): the nightly .u.end flush from kdb into the Delta
# Lake store. Optional: copy to eod.env only to change these defaults.
#   cp eod.env.example eod.env
# The connection itself is DELTA_S3_* in rustfs.env; this file chooses WHAT the flush
# writes and WHERE in the store it lands. Keep comments on their own lines.

# The Delta library: one table per (symbol, UTC day), <SYM>_<YYYY_MM_DD>. live-grid's
# chart seam reads the same library back (LIVE_GRID_LAKE_LIBRARY).
EOD_LIBRARY=ticks_live
# The lake layer. With no tiered DELTA_S3_<TIER>_* variables (this line runs one store)
# every layer resolves to the single store in rustfs.env.
EOD_LAYER=silver
# The donor's hot mirror is off on this line: with one store it would be a second copy
# in the same bucket.
EOD_HOT_SESSIONS=0
