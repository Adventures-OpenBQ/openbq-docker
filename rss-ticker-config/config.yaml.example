# rss-ticker (the local image openbq-rss-ticker:9.0.0, built from ./rss-ticker) for the `web` profile, from
# openbb-docker v8.0.3. A user-agnostic shared feed pool: BDOBB's News widget subscribes
# feed URLs over the websocket, and nothing here names a feed, a user or a key. The
# server refuses to start on any other key.
#
#   cp rss-ticker-config/config.yaml.example rss-ticker-config/config.yaml

# Articles a feed no longer lists are kept this long after they were last seen.
retention_days: 7

# Every feed polls at this interval. Publishers monitor, and an over-eager poller gets
# throttled. 90 suits a pool of wires; 300 suits blogs and newsletters.
default_poll_interval_s: 90

max_concurrent_polls: 8

# 0.0.0.0 on the openbq-internal bridge: nothing is published to the host, and the bridge
# is what decides who can reach the port. There is no authentication.
bind_host: 0.0.0.0

# Live TV: public YouTube channels, resolved on demand and cached for five minutes.
# Connect this server as a backend (https://openbq.YOUR-TAILNET.ts.net:8088)
# and add its single Live TV widget. The first channel is the default. The same
# card plays inline or in BDOBB's desktop Picture in Picture window; iPad is inline.
# The Channel picker also offers Picture in Picture grab for Chrome's floating player.
# Remove this list (or set live_tv: []) to disable Live TV. No API key is needed.
live_tv:
  - key: bloomberg-tv
    label: YouTube - Bloomberg Live
    handle: "@markets"
  - key: schwab-network
    label: YouTube - Schwab Network Live
    handle: "@SchwabNetwork"
  - key: yahoo-finance
    label: YouTube - Yahoo Finance 24/7 Stream
    handle: "@YahooFinance"
# Channels can be off-air; an unavailable stream is reported, never replaced
# with a recording or with another channel. Only configured handles are fetched.
