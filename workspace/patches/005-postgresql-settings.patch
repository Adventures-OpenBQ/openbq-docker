+++ b/backend/scripts/workspace_pg.py
@@ -0,0 +1,287 @@
+"""Explicit pinned Workspace lifecycle. Imported serve performs no database writes."""
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import secrets
+import sqlite3
+import stat
+import subprocess
+import sys
+import tempfile
+
+from scripts import workspace_migration as transfer
+
+KEYS = ('JWT_SECRET', 'OPENBB_AUTH_TOKEN', 'OPENBB_AES_KEY', 'LOCAL_STORAGE_SECRET_KEY')
+OPTIONAL = ('OPENBB_ADMIN_EMAIL', 'OPENBB_ADMIN_PASSWORD', 'OPENBB_FRONTEND_USER_AGENT',
+            'OPENBB_AI_USER_AGENT', 'OPENBB_GEO_KEY', 'OPENBB_CHARGEBEE_SITE_KEY',
+            'OPENBB_CHARGEBEE_API_KEY', 'OKTA_DOMAIN')
+
+
+def selected_serve():
+    return os.environ.get('WORKSPACE_DB_ACTION',
+        'serve' if os.environ.get('DATABASE_TYPE') == 'postgresql' else '') == 'serve'
+
+
+def protected_json(path):
+    path = Path(path)
+    if path.is_symlink() or not path.is_file() or path.stat().st_mode & 0o077:
+        raise ValueError('permission map must be a private regular file')
+    return json.loads(path.read_text())
+
+
+def atomic_json(path, value, *, new=False):
+    path = Path(path)
+    if path.is_symlink():
+        raise ValueError('symlink output refused')
+    fd, temporary = tempfile.mkstemp(prefix='.workspace-', dir=path.parent)
+    try:
+        with os.fdopen(fd, 'w') as output:
+            json.dump(value, output, sort_keys=True)
+            output.flush()
+            os.fsync(output.fileno())
+        if new:
+            os.link(temporary, path)
+        else:
+            os.replace(temporary, path)
+    finally:
+        Path(temporary).unlink(missing_ok=True)
+
+
+def load_keys():
+    path = Path(os.environ.get('DATA_DIR', '/data')) / 'secrets.env'
+    if path.exists():
+        if path.is_symlink() or not path.is_file() or path.stat().st_mode & 0o077:
+            raise ValueError('identity file must be private')
+        for line in path.read_text().splitlines():
+            if not line or line.startswith('#'):
+                continue
+            key, separator, value = line.partition('=')
+            if not separator or key not in KEYS + OPTIONAL:
+                raise ValueError('unsupported identity-file entry')
+            if not os.environ.get(key):
+                os.environ[key] = value
+
+
+def validate_keys():
+    import jwt
+    digest = transfer.identity_digest(os.environ)
+    jwt.decode(os.environ['OPENBB_AUTH_TOKEN'], os.environ['JWT_SECRET'], algorithms=['HS256'])
+    return digest
+
+
+@contextlib.contextmanager
+def database(write=False):
+    from utilities.config import settings
+    if settings.DATABASE_TYPE == 'postgresql':
+        engine = settings.get_write_engine() if write else settings.get_read_engine()
+        try:
+            with engine.connect() as connection:
+                if write and os.environ.get('WORKSPACE_MIGRATION_ROLE'):
+                    role = connection.dialect.identifier_preparer.quote(os.environ['WORKSPACE_MIGRATION_ROLE'])
+                    connection.exec_driver_sql('SET ROLE ' + role)
+                    connection.commit()
+                yield connection, 'postgresql'
+        finally:
+            engine.dispose()
+    elif settings.DATABASE_TYPE == 'sqlite':
+        with transfer.sqlite_read(Path(settings.DB_PATH)) as connection:
+            yield connection, 'sqlite'
+    else:
+        raise ValueError('explicit lifecycle supports only PostgreSQL or restored SQLite')
+
+
+def schema(connection, dialect):
+    manifest = transfer.load_manifest()
+    if dialect == 'postgresql':
+        transfer.validate_postgres(connection, manifest)
+    elif transfer.validate_sqlite(connection, manifest)[0] != transfer.HEAD:
+        raise ValueError('restored SQLite must be at the patched head')
+
+
+def validate_runtime():
+    load_keys()
+    digest = validate_keys()
+    mapping = protected_json(os.environ['WORKSPACE_PERMISSION_MAP_FILE'])
+    if mapping.get('identity_digest') != digest:
+        raise ValueError('identity material differs from approved mapping')
+    with database() as (connection, dialect):
+        schema(connection, dialect)
+        result = transfer.permission_mapping(connection, dialect, mapping)
+        if dialect == 'postgresql':
+            ready = connection.exec_driver_sql(
+                'SELECT identity_digest,entity_uuid,inviting_uuid FROM workspace_admin.readiness WHERE singleton=true').all()
+            expected = (digest, mapping['entity_uuid'], mapping['inviting_uuid'])
+            if len(ready) != 1 or tuple(str(v) for v in ready[0]) != expected:
+                raise ValueError('database has no matching completed readiness')
+    return result
+
+
+def write_permission_mapping(value):
+    atomic_json(Path('/opt/code/user_create.json'), value)
+    if os.geteuid() == 0:
+        import pwd
+        user = pwd.getpwnam('appuser')
+        os.chown('/opt/code/user_create.json', user.pw_uid, user.pw_gid)
+
+
+def fresh_check():
+    # Only the actual seed tables may contain data. No ORM or create-if-missing.
+    with database(write=True) as (connection, dialect):
+        if dialect != 'postgresql':
+            raise ValueError('fresh bootstrap requires provisioned PostgreSQL')
+        schema(connection, dialect)
+        if connection.exec_driver_sql('SELECT count(*) FROM workspace_admin.readiness').scalar_one():
+            raise ValueError('database already initialized')
+        manifest = transfer.load_manifest()
+        if transfer.seed_signature(connection, manifest) != manifest['seed_signature']:
+            raise ValueError('bootstrap requires the known fresh seed state')
+        seeds = {'alembic_version', 'tier', 'default_tier', 'data_bundle'}
+        for table in manifest['schemas']['postgresql-' + transfer.HEAD]['schema']['tables']:
+            if table not in seeds and connection.exec_driver_sql(
+                    'SELECT EXISTS(SELECT 1 FROM public.' + transfer.identifier(table) + ')').scalar_one():
+                raise ValueError('bootstrap refuses existing application data')
+
+
+def checked_run(command, *, environment=None):
+    # Upstream scripts may log email/password or DB detail. Keep output private
+    # in memory and emit only a fixed category, including on child failure.
+    result = subprocess.run(command, env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if result.returncode:
+        raise RuntimeError('explicit lifecycle child failed')
+
+
+def bootstrap():
+    path = Path(os.environ['WORKSPACE_PERMISSION_MAP_FILE'])
+    if path.exists() or path.is_symlink():
+        raise ValueError('bootstrap mapping destination must be new')
+    check_env = dict(os.environ)
+    check_env.setdefault('OPENBB_AES_KEY', '0' * 16)
+    check_env.setdefault('JWT_SECRET', 'offline-schema-validation')
+    checked_run([sys.executable, '-m', 'scripts.workspace_pg', 'fresh-check'], environment=check_env)
+    # Fresh bootstrap alone prepares the pinned Redis/folder companions. Imported
+    # serve never changes directory ownership or preserved identity files.
+    import pwd
+    data = Path(os.environ.get('DATA_DIR', '/data'))
+    if any(parent.is_symlink() for parent in (data, *data.parents)):
+        raise ValueError('bootstrap data symlink refused')
+    directories = [data, *(data / name for name in ('redis', 'storage', 'state'))]
+    for directory in directories:
+        if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
+            raise ValueError('bootstrap companion must be a directory')
+    user = pwd.getpwnam('appuser')
+    for directory in directories:
+        directory.mkdir(exist_ok=True, mode=0o700)
+        os.chown(directory, user.pw_uid, user.pw_gid)
+    load_keys()
+    import jwt
+    os.environ.setdefault('JWT_SECRET', secrets.token_hex(48))
+    os.environ.setdefault('OPENBB_AES_KEY', secrets.token_hex(8))
+    os.environ.setdefault('LOCAL_STORAGE_SECRET_KEY', secrets.token_urlsafe(32))
+    os.environ.setdefault('OPENBB_AUTH_TOKEN', jwt.encode({'sub': 'openbb'}, os.environ['JWT_SECRET'], algorithm='HS256'))
+    digest = validate_keys()
+    if not os.environ.get('OPENBB_ADMIN_EMAIL') or not os.environ.get('OPENBB_ADMIN_PASSWORD'):
+        raise ValueError('explicit bootstrap requires administrator inputs')
+    data = Path(os.environ.get('DATA_DIR', '/data'))
+    data.mkdir(exist_ok=True, mode=0o700)
+    secret_file = data / 'secrets.env'
+    if not secret_file.exists():
+        with open(secret_file, 'x', opener=lambda p, f: os.open(p, f, 0o600)) as output:
+            output.write(''.join(key + '=' + os.environ[key] + '\n' for key in KEYS))
+    Path('/opt/code/user_create.json').unlink(missing_ok=True)
+    cfg = Path('/opt/code/scripts/cfgs')
+    cfg.mkdir(exist_ok=True)
+    text = ('[entity]\nname="OpenBB Lite"\nseats=10000\naum=1000\ncompany_type="CORPORATION"\n'
+            'organization_size="SMALL"\ncountry="DOM"\n[[admins]]\nfirst_name="Lite"\nlast_name="Admin"\n')
+    # JSON basic strings are valid TOML strings for these validated inputs.
+    text += 'email=' + json.dumps(os.environ['OPENBB_ADMIN_EMAIL']) + '\npassword=' + json.dumps(os.environ['OPENBB_ADMIN_PASSWORD']) + '\n'
+    config_file = cfg / '.workspace-bootstrap.toml'
+    try:
+        config_file.write_text(text)
+        config_file.chmod(0o600)
+        checked_run([sys.executable, '-c', """
+import asyncio,os,tomllib
+from sqlalchemy import event
+from sqlalchemy.engine import Engine
+from sqlalchemy.dialects.postgresql import dialect
+# This listener exists only in this short-lived explicit bootstrap child.
+# All of its factories use the same migrator credentials; runtime never installs it.
+if (os.environ['READ_DB_USER'] != os.environ['WRITE_DB_USER'] or
+        os.environ['READ_DB_PASSWORD'] != os.environ['WRITE_DB_PASSWORD'] or
+        os.environ['WORKSPACE_MIGRATION_ROLE'] != 'openbq_workspace_owner'):
+    raise ValueError('explicit bootstrap requires one approved migrator identity')
+role = dialect().identifier_preparer.quote(os.environ['WORKSPACE_MIGRATION_ROLE'])
+@event.listens_for(Engine, 'connect')
+def select_bootstrap_role(connection, record):
+    cursor = connection.cursor()
+    try:
+        cursor.execute('SET ROLE ' + role)
+        connection.commit()  # initialization rollback must not undo the session role
+    finally: cursor.close()
+from scripts.init_users import Config,SetupConfig,init_trial_mappings,aget_write_db
+async def run():
+    await init_trial_mappings()
+    with open('/opt/code/scripts/cfgs/.workspace-bootstrap.toml','rb') as f: config=Config(**tomllib.load(f))
+    async for db in aget_write_db(): await SetupConfig(config,db).run()
+asyncio.run(run())
+"""])
+    finally:
+        config_file.unlink(missing_ok=True)
+    generated = json.loads(Path('/opt/code/user_create.json').read_text())
+    with database(write=True) as (connection, dialect):
+        row = connection.exec_driver_sql('SELECT entity_uuid FROM permissions_entity_map WHERE uuid=%s',
+                                        (generated['on_prem_admin_uuid'],)).one()
+        mapping = {'entity_uuid': str(row[0]), 'inviting_uuid': generated['inviting_uuid'], 'identity_digest': digest}
+        transfer.permission_mapping(connection, dialect, mapping)
+        connection.exec_driver_sql('INSERT INTO workspace_admin.readiness(singleton,identity_digest,entity_uuid,inviting_uuid) VALUES(true,%s,%s,%s)',
+                                   (digest, mapping['entity_uuid'], mapping['inviting_uuid']))
+        connection.commit()
+    atomic_json(path, mapping, new=True)
+
+
+def main():
+    action = sys.argv[1] if len(sys.argv) > 1 else os.environ.get('WORKSPACE_DB_ACTION', 'serve')
+    if action == 'fresh-check':
+        fresh_check()
+    elif action == 'migrate':
+        # Configuration imports require these fields; maintenance never persists
+        # them or starts authentication/listeners. No runtime keys are generated.
+        os.environ.setdefault('OPENBB_AES_KEY', '0' * 16)
+        os.environ.setdefault('JWT_SECRET', 'offline-schema-validation')
+        checked_run([sys.executable, '-m', 'alembic', 'upgrade', 'head'])
+    elif action == 'bootstrap':
+        from sqlalchemy.engine import URL
+        url=URL.create('postgresql+psycopg2',username=os.environ['WRITE_DB_USER'],
+            password=os.environ['WRITE_DB_PASSWORD'],host=os.environ['DB_HOST'],
+            port=int(os.environ.get('DB_PORT','5432')),database=os.environ['DB_NAME'])
+        engine=transfer.pg_engine(url)
+        try:
+            with transfer.locked_target(engine):
+                bootstrap()
+        finally:
+            engine.dispose()
+    elif action == 'serve':
+        if os.environ.get('WORKERS', '1') != '1':
+            raise ValueError('selected profile requires one worker')
+        write_permission_mapping(validate_runtime())
+        checked_run(['/usr/local/bin/render-frontend-config.sh'])
+        template = Path('/etc/nginx/templates/default.conf.template').read_text()
+        port = int(os.environ.get('PORT', '3000'))
+        if not 1 <= port <= 65535:
+            raise ValueError('invalid port')
+        Path('/etc/nginx/sites-available/default').write_text(template.replace('${PORT}', str(port)))
+        link = Path('/etc/nginx/sites-enabled/default')
+        if not link.exists():
+            link.symlink_to('/etc/nginx/sites-available/default')
+        os.execv('/usr/local/bin/supervisord', ['supervisord', '-c', '/etc/supervisor/supervisord.conf'])
+    else:
+        raise ValueError('unsupported lifecycle action')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception as exc:
+        print('Workspace lifecycle refused (' + type(exc).__name__ + ').', file=sys.stderr)
+        raise SystemExit(1) from None
