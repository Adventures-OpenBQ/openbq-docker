+def run_postgresql_migrations():
+    # The same physical session owns the lock, checks the revision, executes DDL
+    # and releases the lock. A terminated migrator loses its session lock.
+    kwargs = settings.pg_engine_kwargs()
+    for name in ("pool_size", "max_overflow", "pool_timeout", "pool_recycle", "pool_pre_ping"):
+        kwargs.pop(name, None)
+    engine = create_engine(database_url, poolclass=pool.NullPool, **kwargs)
+    try:
+        with engine.connect() as connection:
+            deadline = time.monotonic() + settings.DB_POOL_TIMEOUT
+            acquired = False
+            try:
+                while not acquired:
+                    acquired = connection.execute(text("SELECT pg_try_advisory_lock(1791763200, 5)")).scalar_one()
+                    connection.commit()
+                    if not acquired:
+                        if time.monotonic() >= deadline:
+                            raise TimeoutError("migration lock acquisition expired")
+                        time.sleep(0.1)
+                role = os.environ.get("WORKSPACE_MIGRATION_ROLE")
+                if role:
+                    connection.exec_driver_sql("SET ROLE " + connection.dialect.identifier_preparer.quote(role))
+                    connection.commit()
+                tables = set(inspect(connection).get_table_names(schema="public"))
+                if tables and "alembic_version" not in tables:
+                    raise ValueError("unmanaged schema")
+                if tables:
+                    # This compatibility profile only accepts a complete existing
+                    # target. Never stamp/repair an unknown or partial PG layout.
+                    from scripts.workspace_migration import validate_postgres, load_manifest
+                    validate_postgres(connection, load_manifest())
+                connection.commit()
+                # Revision inspection happens here, after this session acquired
+                # the lock, including after another migrator completed.
+                context.configure(connection=connection, target_metadata=target_metadata,
+                                  user_module_prefix="model_helpers.")
+                with context.begin_transaction():
+                    context.run_migrations()
+                    from scripts.workspace_migration import validate_postgres, load_manifest
+                    validate_postgres(connection, load_manifest())
+            finally:
+                connection.rollback()
+                if acquired:
+                    connection.execute(text("SELECT pg_advisory_unlock(1791763200, 5)"))
+                    connection.commit()
+    finally:
+        engine.dispose()
+
+
