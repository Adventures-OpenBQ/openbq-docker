+# openbq-docker: BDOBB's hidden system dashboards, the same contract as openbq-docker's key mode
+# (v3/openbq_settings.py). One per owner and reserved id, kept in system_dashboard, which no
+# listing reads; PUT and DELETE carry the client's revision and the newest one wins.
+SYSTEM_DASHBOARD_IDS = {"docks"}
+SYSTEM_DASHBOARD_MAX_BYTES = 5_000_000
+
+
+def _system_date(value):
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=UTC)
+    return value.astimezone(UTC).isoformat().replace("+00:00", "Z")
+
+
+def _system_record(row: SystemDashboard, user: User) -> dict:
+    return {"id": row.system_id, "hidden": True, "revision": row.revision, "creator": True,
+            "content": row.content, "created_date": _system_date(row.created_date),
+            "updated_date": _system_date(row.updated_date), "created_by": user.email, "is_shared": False}
+
+
+async def _system_row(db: AsyncSession, user: User, system_id: str, lock: bool = False):
+    query = select(SystemDashboard).where(
+        SystemDashboard.owner_uuid == user.uuid, SystemDashboard.system_id == system_id
+    )
+    return (await db.execute(query.with_for_update() if lock else query)).scalar_one_or_none()
+
+
+def _system_newer(row: SystemDashboard, user: User) -> JSONResponse:
+    return JSONResponse({"detail": "A newer revision is stored.", "dashboard": _system_record(row, user)},
+                        status_code=409)
+
+
+def _system_unknown(system_id: str) -> None:
+    if system_id not in SYSTEM_DASHBOARD_IDS:
+        raise HTTPException(status_code=404, detail="No such system dashboard.")
+
+
+@router.get("/sync/system/{system_id}")
+async def get_system_dashboard(
+    system_id: str,
+    db: AsyncSession = Depends(aget_write_db),
+    user: User = Depends(auth_helpers.GetCurrentUser(["uuid", "email"], pro=True)),
+):
+    _system_unknown(system_id)
+    row = await _system_row(db, user, system_id)
+    return JSONResponse({"dashboard": _system_record(row, user) if row else None})
+
+
+@router.put("/sync/system/{system_id}")
+async def put_system_dashboard(
+    system_id: str,
+    request: Request,
+    db: AsyncSession = Depends(aget_write_db),
+    user: User = Depends(auth_helpers.GetCurrentUser(["uuid", "email"], pro=True)),
+):
+    _system_unknown(system_id)
+    raw = await request.body()
+    if len(raw) > SYSTEM_DASHBOARD_MAX_BYTES:
+        return JSONResponse({"detail": "The body exceeds 5 MB."}, status_code=413)
+    try:
+        body = json.loads(raw)
+    except ValueError:
+        body = None
+    revision = body.get("revision") if isinstance(body, dict) else None
+    if (not isinstance(body, dict) or set(body) != {"revision", "content"} or not isinstance(body["content"], dict)
+            or type(revision) is not int or not 0 <= revision < 2**63):
+        return JSONResponse({"detail": "The body must be {revision: non-negative integer, content: object}."},
+                            status_code=400)
+    row = await _system_row(db, user, system_id, lock=True)
+    if row is not None and row.revision > revision:
+        newer = _system_newer(row, user)  # before the rollback expires the row
+        await db.rollback()
+        return newer
+    if row is None:
+        row = SystemDashboard(owner_uuid=user.uuid, system_id=system_id, revision=revision, content=body["content"])
+        db.add(row)
+    else:
+        row.revision, row.content = revision, body["content"]
+    try:
+        await db.commit()
+    except IntegrityError:
+        # A concurrent first write won the unique (owner, id) row: re-read it under lock and decide
+        # as if it had been read first -- 409 only when it is newer, else this write updates it.
+        await db.rollback()
+        row = await _system_row(db, user, system_id, lock=True)
+        if row is None:
+            # ...and a DELETE removed it again before this re-read: insert after all.
+            row = SystemDashboard(owner_uuid=user.uuid, system_id=system_id, revision=revision, content=body["content"])
+            db.add(row)
+        elif row.revision > revision:
+            newer = _system_newer(row, user)  # before the rollback expires the row
+            await db.rollback()
+            return newer
+        else:
+            row.revision, row.content = revision, body["content"]
+        await db.commit()
+    await db.refresh(row)
+    return JSONResponse({"success": True, "dashboard": _system_record(row, user)})
+
+
+@router.delete("/sync/system/{system_id}")
+async def delete_system_dashboard(
+    system_id: str,
+    request: Request,
+    db: AsyncSession = Depends(aget_write_db),
+    user: User = Depends(auth_helpers.GetCurrentUser(["uuid", "email"], pro=True)),
+):
+    _system_unknown(system_id)
+    params = request.query_params
+    raw = params.getlist("revision")
+    if (len(raw) != 1 or set(params) != {"revision"} or not raw[0].isascii() or not raw[0].isdigit()
+            or len(raw[0]) > 18):
+        return JSONResponse({"detail": "DELETE takes exactly ?revision=<non-negative integer>."}, status_code=400)
+    row = await _system_row(db, user, system_id, lock=True)
+    if row is not None and row.revision > int(raw[0]):
+        newer = _system_newer(row, user)  # before the rollback expires the row
+        await db.rollback()
+        return newer
+    if row is not None:
+        await db.delete(row)
+        await db.commit()
+    return JSONResponse({"success": True})
+
+
