# Copy to a private0600 file. Supply existing identity material without rotation.
DATABASE_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=openbq_workspace
READ_DB_USER=openbq_workspace_read
READ_DB_PASSWORD=
WRITE_DB_USER=openbq_workspace_write
WRITE_DB_PASSWORD=
SSL_CA=/run/workspace-tls/ca.crt
# SSL_CERT and SSL_KEY must either both be supplied or both remain empty.
SSL_CERT=
SSL_KEY=
# Without TLS material PostgreSQL refuses to start; set 1 only for a deliberate plaintext link.
# WORKSPACE_POSTGRES_ALLOW_PLAINTEXT=1
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30000
DB_LOCK_TIMEOUT=5000
WORKERS=1
WORKSPACE_DB_ACTION=serve
WORKSPACE_PERMISSION_MAP_FILE=/data/permission-map.json
# Existing /data/secrets.env can supply these instead. Do not generate on serve.
JWT_SECRET=
OPENBB_AUTH_TOKEN=
OPENBB_AES_KEY=
LOCAL_STORAGE_SECRET_KEY=
REDIS_HOST=127.0.0.1
MODE=lite
