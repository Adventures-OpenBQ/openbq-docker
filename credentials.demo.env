# Public demo keys, published by the providers themselves for trying their APIs; not secrets.
# Compose loads this file before credentials.env, so a key set there wins. Rate-limited:
# api.data.gov's DEMO_KEY allows 30 requests an hour and 50 a day per IP address.
# Checked live: docs/credentials-demo-receipt.md. Only the names and values allowed by
# tests/test_credentials_demo.py may appear here.
EIA_API_KEY=DEMO_KEY
CONGRESS_GOV_API_KEY=DEMO_KEY
