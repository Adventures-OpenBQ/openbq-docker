# Optional comma-separated browser origins for the reference backend.
# Add your Workspace or Vercel origin (scheme + hostname + port, no path).
# The default includes http://localhost:1420. Keep real deployment origins private.
EXTRA_CORS_ORIGINS=

# Omni code execution on the reference backend: languages it may run.
# Default: sql (Python is barred). Add python (sql,python) only on a trusted,
# private backend. Empty: SQL and Python Omni requests are refused with 403.
# Display-only Omni widgets work either way.
OPENBQ_OMNI_EXEC_ALLOWED=sql
