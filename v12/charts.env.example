# Art's Charts (v12, profile charts-v12), read by arts-charts and arts-charts-worker after
# credentials.env (the stack's Basic pair, OPENBB_API_AUTH=true). Copy and lock it:
#   cp v12/charts.env.example v12/charts.env && chmod 600 v12/charts.env
# A commented key keeps arts-charts' own default; an empty key means "off".

# Signs wake, button, link and worker tokens. Required:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ARTS_CHARTS_SECRET=
# ODP. With the temporaldb-v11 profile: http://openbq-v11:6900.
ARTS_CHARTS_ODP_URL=http://openbq-api:6900
# A separate ODP pair (default: the stack's):
# ARTS_CHARTS_ODP_USER=
# ARTS_CHARTS_ODP_PASSWORD=
# live-grid, when the `live` profile runs: http://live-grid:6903. Empty: charts are history only.
ARTS_CHARTS_LIVE_GRID_URL=
# PostgreSQL instead of the arts-charts-data volume's SQLite (sqlite:////data/arts-charts.db):
# ARTS_CHARTS_DB=postgresql://<user>:<password>@<host>:5432/<database>
# yfinance (default), eodhd, or temporaldb when the TemporalDB settings below are set:
# ARTS_CHARTS_DEFAULT_PROVIDER=yfinance
# TemporalDB (temporaldb-v11 profile): http://temporaldb-api:8080 and a scope-policy token.
ARTS_CHARTS_TEMPORAL_URL=
ARTS_CHARTS_TEMPORAL_TOKEN=
# ARTS_CHARTS_TEMPORAL_DATASET=eodhd.eod
# agent-rita for watch and schedule replies. Empty: every firing is a plain notice.
ARTS_CHARTS_RITA_URL=
# ntfy: the one topic, and the worker's token (`ntfy token add`, v12/RUNBOOK.md). Required.
ARTS_CHARTS_NTFY_TOPIC=
ARTS_CHARTS_NTFY_TOKEN=
# The one base on push links and buttons: the gateway door's origin
# (https://openbq.<your-tailnet>.ts.net:10000) when the gateway's "charts" is on, else
# https://openbq-charts.<your-tailnet>.ts.net. Required.
ARTS_CHARTS_PUBLIC_URL=
# Pushes an hour:
# ARTS_CHARTS_PUSH_CAP=12
# A BDOBB link for an ntfy "view" button, {id} filled in (arts-charts with part 2's C-2):
# ARTS_CHARTS_APP_LINK=
# Custom studies and macros:
# TA_STUDIES_DIR=
# TA_STUDIES_API=
# TA_MACRO_DIR=
# TA_PUSH_INTERVAL_MS=1000
# Compose interpolation for the ntfy service. These go in the repository's .env, NOT this file:
#   NTFY_BASE_URL=<the door the phone uses>   NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
